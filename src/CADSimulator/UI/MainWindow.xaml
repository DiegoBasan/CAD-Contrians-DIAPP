<Window x:Class="CADSimulator.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CADSimulator.UI"
        Title="CAD Assembly Simulator" Height="720" Width="1280">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Import STEP..." Click="ImportStep_Click" />
                <MenuItem Header="_Save Project..." Click="SaveProject_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
        </Menu>

        <ui:ControlPad DockPanel.Dock="Right" Width="260" />

        <ui:SequencePanel DockPanel.Dock="Bottom" Height="180" />

        <TreeView x:Name="AssemblyTree" DockPanel.Dock="Left" Width="220" />

        <ui:PropertyPanel DockPanel.Dock="Right" Width="260" />

        <Viewport3D x:Name="Viewport" />
    </DockPanel>
</Window>
