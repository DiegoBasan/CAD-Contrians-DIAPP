<Window x:Class="CADSimulator.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CADSimulator.UI"
        Title="CAD Assembly Simulator" Height="720" Width="1280">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Import STEP..." Click="ImportStep_Click" />
                <MenuItem Header="_Save Project..." Click="SaveProject_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
        </Menu>

        <ui:ControlPad DockPanel.Dock="Right" Width="260" />

        <ui:SequencePanel DockPanel.Dock="Bottom" Height="180" />

        <TreeView x:Name="AssemblyTree" DockPanel.Dock="Left" Width="240"
                  SelectedItemChanged="AssemblyTree_SelectedItemChanged" />

        <ui:PropertyPanel x:Name="PropertyPanelControl" DockPanel.Dock="Right" Width="260" />

        <Viewport3D x:Name="Viewport"
                    MouseDown="Viewport_MouseDown"
                    MouseUp="Viewport_MouseUp"
                    MouseMove="Viewport_MouseMove"
                    MouseWheel="Viewport_MouseWheel">
            <Viewport3D.Camera>
                <PerspectiveCamera x:Name="Camera" Position="1000,1000,1000" LookDirection="-1,-1,-1"
                                    UpDirection="0,0,1" FieldOfView="45" />
            </Viewport3D.Camera>
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <AmbientLight Color="#404040" />
                        <DirectionalLight Color="#BFBFBF" Direction="-1,-1,-1" />
                        <DirectionalLight Color="#404040" Direction="1,1,1" />
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>
            <ModelVisual3D x:Name="SceneRoot" />
        </Viewport3D>
    </DockPanel>
</Window>
