<UserControl x:Class="CADSimulator.UI.SequencePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
            <Button x:Name="RecordButton" Content="REC" Width="60" Click="Record_Click" />
            <Button x:Name="PlayButton" Content="PLAY" Width="60" Click="Play_Click" />
            <Button x:Name="StopButton" Content="STOP" Width="60" Click="Stop_Click" />
        </StackPanel>
        <Slider x:Name="Timeline" DockPanel.Dock="Bottom" Minimum="0" Maximum="1000" />
        <ListBox x:Name="KeyframeList" />
    </DockPanel>
</UserControl>
